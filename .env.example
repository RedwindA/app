# MinerU API token (Bearer; never logged or returned to clients)
MINERU_TOKEN=

# Single-user login password (plaintext at rest in env, bcrypt-hashed in memory)
APP_PASSWORD=

# JWT signing secret — generate with: openssl rand -hex 32
APP_JWT_SECRET=

# Optional overrides
APP_JWT_EXP_HOURS=24
MAX_JOB_HISTORY=20
DATA_DIR=/data
MINERU_BASE_URL=https://mineru.net
